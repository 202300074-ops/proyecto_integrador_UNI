{
  "name": "sak-po-kaab",
  "version": "0.1.0",
  "private": true,
  "description": "Tienda en linea y experiencia multimedia de Sak P'o' Kaab",
  "workspaces": [
    "server",
    "apps/store"
  ],
  "scripts": {
    "dev": "concurrently -n api,store -c blue,magenta \"npm:dev:api\" \"npm:dev:store\"",
    "dev:api": "npm run dev --workspace @sak-po-kaab/server",
    "dev:store": "npm run dev --workspace @sak-po-kaab/store",
    "build": "npm run build --workspace @sak-po-kaab/store",
    "start": "npm run start --workspace @sak-po-kaab/server",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20"
  }
}
